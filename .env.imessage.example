# Copy to .env in the dedicated iMessage checkout (not the main checkout).
# Set DB_PASSWORD before the first deploy. If the database already exists,
# keep its current password unless you also rotate it in Postgres.
COMPOSE_PROJECT_NAME=swejobs-imessage
COMPOSE_PROFILES=imessage
STACK=swejobs-imessage
APP_PORT=8001
DELIVERY_CHANNEL=imessage

DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# Photon Spectrum project credentials from https://app.photon.codes
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Generate a shared secret with: openssl rand -hex 32
IMESSAGE_WEBHOOK_SECRET=
IMESSAGE_SIDECAR_URL=http://imessage-sidecar:8789
IMESSAGE_REQUEST_TIMEOUT=15
# Optional comma-separated phone numbers/emails for admin alerts only.
IMESSAGE_RECIPIENTS=

# Telegram settings are not needed. Optional scraper settings are listed
# in .env.example; copy over only the keys you actually use.
