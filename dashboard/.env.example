# Dashboard environment variables (Vercel / local dev)
#
# Copy this file to `.env.local` for local development, or set these in the
# Vercel project settings. Every VITE_* variable is PUBLIC and embedded in the
# build output — NEVER put secrets, JWT keys, passwords, database credentials,
# TOTP encryption keys, or service-role keys here.

# Required: exact origin of the FastAPI backend. No trailing slash.
VITE_API_BASE=http://localhost:8000

# Required in deployed environments: environment label surfaced in the UI.
# Use "production" or "staging".
VITE_APP_ENV=development

# Optional: commit SHA for diagnostics. On Vercel use ${vercel.gitCommitSha}.
VITE_RELEASE_SHA=
