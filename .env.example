# =============================================================================
# SWE-Jobs v2 — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — self-hosted Postgres container (docker-compose "db" service)
# -----------------------------------------------------------------------------
DB_HOST=db            # 'db' = compose service. Outside compose use DB_HOST=localhost + DB_PORT=15432
DB_PORT=5432          # in-compose port; host-published port is 127.0.0.1:15432 (see docker-compose.yml)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change-me-strong-local-password
DB_SSLMODE=disable    # 'disable' for the local container; 'require' for a managed host

# To point back at Supabase (managed Postgres) instead of the container:
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_PORT=6543              # transaction pooler; use 5432 (session) for pg_dump
#   DB_USER=postgres.<project-ref>
#   DB_PASSWORD=<your-supabase-db-password>
#   DB_SSLMODE=require

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_GROUP_ID=-1001234567890

# -----------------------------------------------------------------------------
# Topic Thread IDs
# Set each to the thread_id of the corresponding Telegram topic.
# Leave blank to skip that topic.
# -----------------------------------------------------------------------------
TOPIC_GENERAL=
TOPIC_BACKEND=
TOPIC_FRONTEND=
TOPIC_MOBILE=
TOPIC_DEVOPS=
TOPIC_QA=
TOPIC_AI_ML=
TOPIC_CYBERSECURITY=
TOPIC_GAMEDEV=
TOPIC_BLOCKCHAIN=
TOPIC_FULLSTACK=
TOPIC_EGYPT=
TOPIC_SAUDI=
TOPIC_INTERNSHIPS=
TOPIC_ERP=

# -----------------------------------------------------------------------------
# API Keys (all optional — sources are skipped if key is absent)
# -----------------------------------------------------------------------------
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FINDWORK_API_KEY=
JOOBLE_API_KEY=
REED_API_KEY=
MUSE_API_KEY=

# -----------------------------------------------------------------------------
# Playwright / Browser-based scrapers (optional)
# LinkedIn Posts requires login cookies — export via browser extension
# X/Twitter requires cookies or auth token
# -----------------------------------------------------------------------------
LINKEDIN_COOKIES_FILE=
TWITTER_COOKIES_FILE=
X_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Docker / Network (change if port 8000 is taken by another service)
# -----------------------------------------------------------------------------
APP_PORT=8000

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
ADMIN_TELEGRAM_ID=
SEED_MODE=false

# -----------------------------------------------------------------------------
# Scheduler (how often the server runs the fetch-and-send pipeline)
# -----------------------------------------------------------------------------
FETCH_INTERVAL_MINUTES=5
