# =============================================================================
# SWE-Jobs v2 — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — self-hosted Postgres container (docker-compose "db" service)
# -----------------------------------------------------------------------------
DB_HOST=db            # 'db' = compose service. Outside compose use DB_HOST=localhost + DB_PORT=15432
DB_PORT=5432          # in-compose port; host-published port is 127.0.0.1:15432 (see docker-compose.yml)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change-me-strong-local-password
DB_SSLMODE=disable    # 'disable' for the local container; 'require' for a remote host requiring SSL

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_GROUP_ID=-1001234567890

# -----------------------------------------------------------------------------
# Topic Thread IDs
# Set each to the thread_id of the corresponding Telegram topic.
# Leave blank to skip that topic.
# -----------------------------------------------------------------------------
TOPIC_GENERAL=
TOPIC_BACKEND=
TOPIC_FRONTEND=
TOPIC_MOBILE=
TOPIC_DEVOPS=
TOPIC_QA=
TOPIC_AI_ML=
TOPIC_CYBERSECURITY=
TOPIC_GAMEDEV=
TOPIC_BLOCKCHAIN=
TOPIC_FULLSTACK=
TOPIC_EGYPT=
TOPIC_SAUDI=
TOPIC_INTERNSHIPS=
TOPIC_ERP=
TOPIC_MARKETING_SALES=
TOPIC_HR_RECRUITING=
TOPIC_FINANCE_ACCOUNTING=
TOPIC_ADMIN_OPERATIONS=
TOPIC_CUSTOMER_SUPPORT=
TOPIC_PRODUCT_PM=

# -----------------------------------------------------------------------------
# API Keys (all optional — sources are skipped if key is absent)
# -----------------------------------------------------------------------------
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FINDWORK_API_KEY=
JOOBLE_API_KEY=
REED_API_KEY=
MUSE_API_KEY=

# -----------------------------------------------------------------------------
# Playwright / Browser-based scrapers (optional)
# LinkedIn Posts requires login cookies — export via browser extension
# X/Twitter requires cookies or auth token
# -----------------------------------------------------------------------------
LINKEDIN_COOKIES_FILE=
TWITTER_COOKIES_FILE=
X_AUTH_TOKEN=

# Number of 20-job pages fetched per public Wuzzuf category.
WUZZUF_MAX_PAGES=3

# -----------------------------------------------------------------------------
# Docker / Network (change if port 8000 is taken by another service)
# -----------------------------------------------------------------------------
APP_PORT=8000

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
ADMIN_TELEGRAM_ID=
SEED_MODE=false

# Comma-separated exact dashboard origins permitted by FastAPI CORS (with
# credentials). NEVER use "*". Example: https://admin.example.com
# Required once the admin dashboard ships; documented in docs/DASHBOARD_DEPLOYMENT.md.
# DASHBOARD_ORIGINS=

# Frontend build variables are now in dashboard/.env.example (VITE_* are public).

# -----------------------------------------------------------------------------
# Admin authentication (JWT, TOTP)
# -----------------------------------------------------------------------------
# Comma-separated exact dashboard origins permitted by FastAPI CORS (with
# credentials). NEVER use "*". Example: https://admin.example.com
DASHBOARD_ORIGINS=http://localhost:5173

# JWT signing — Ed25519 private key in hex. Generate with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; k=Ed25519PrivateKey.generate(); print(k.private_bytes(Encoding.Raw, PrivateFormat.Raw, NoEncryption()).hex())"
# JWT_SIGNING_KEY=<64-byte-hex>
JWT_KEY_ID=local-dev-key
JWT_ISSUER=swe-jobs-api
JWT_AUDIENCE=swe-jobs-dashboard

# TOTP secret encryption key (32 bytes hex). Generate with:
#   python -c "import os; print(os.urandom(32).hex())"
# TOTP_ENCRYPTION_KEY=<64-byte-hex>

# -----------------------------------------------------------------------------
# Scheduler
# -----------------------------------------------------------------------------
# Fetching runs every FETCH_INTERVAL_MINUTES. Delivery runs independently every
# DELIVERY_INTERVAL_SECONDS. They may overlap; each has its own concurrency lock.
FETCH_INTERVAL_MINUTES=5
DELIVERY_INTERVAL_SECONDS=60
DELIVERY_BATCH_SIZE=50
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BASE_SECONDS=30
DELIVERY_PROCESSING_LEASE_SECONDS=600
DELIVERY_IDLE_SLEEP_SECONDS=10
DELIVERY_MAX_CYCLE_SECONDS=50
DM_MAX_PER_USER_PER_WINDOW=20
DM_RATE_WINDOW_SECONDS=3600

# -----------------------------------------------------------------------------
# Telegram polling supervision (bot/polling.py — all optional)
# Brief Telegram outages (502s, timeouts) retry automatically; the supervisor
# rebuilds the poller in-process after a continuous failure streak, and exits
# for a container restart only if recovery keeps failing.
# -----------------------------------------------------------------------------
# TELEGRAM_POLL_CHECK_INTERVAL=30     # seconds between liveness checks
# TELEGRAM_POLL_STUCK_THRESHOLD=300   # continuous failure streak (s) that triggers a rebuild
# TELEGRAM_POLL_STARTUP_RETRIES=5     # initial start attempts before exiting
# TELEGRAM_POLL_RECOVERY_ATTEMPTS=3   # rebuild attempts per incident before exiting
# TELEGRAM_POLL_BACKOFF_INITIAL=2     # first retry delay (s)
# TELEGRAM_POLL_BACKOFF_MAX=60        # retry delay ceiling (s)
# TELEGRAM_POLL_STOP_TIMEOUT=30       # teardown timeout (s) before abandoning an instance
